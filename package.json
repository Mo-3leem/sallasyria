{
  "name": "sallasyria",
  "version": "0.1.0",
  "private": true,
  "description": "Salla Syria — multi-tenant e-commerce platform (Hono + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrations:create": "wrangler d1 migrations create sallasyria-db",
    "db:migrations:list": "wrangler d1 migrations list sallasyria-db --local",
    "db:migrate:local": "wrangler d1 migrations apply sallasyria-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sallasyria-db --remote",
    "db:clean": "node scripts/clean-verify.mjs",
    "db:seed": "node scripts/seed.mjs",
    "backup": "node scripts/backup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "db:test:phase1": "node scripts/verify-phase1.mjs",
    "db:test:phase2": "node scripts/verify-phase2.mjs",
    "db:test:phase3": "node scripts/verify-phase3.mjs",
    "db:test:phase4": "node scripts/verify-phase4.mjs",
    "db:test:adversarial": "node scripts/verify-adversarial.mjs",
    "db:test:sessions": "node scripts/verify-sessions.mjs",
    "db:test:idempotency": "node scripts/verify-idempotency.mjs",
    "db:test:all": "node scripts/clean-verify.mjs && node scripts/verify-phase1.mjs && node scripts/verify-phase2.mjs && node scripts/verify-phase3.mjs && node scripts/verify-phase4.mjs && node scripts/verify-adversarial.mjs && node scripts/verify-sessions.mjs && node scripts/verify-idempotency.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^26.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.2"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  }
}
