# Copy to .dev.vars for local development (NEVER commit the real file).
# Production values live ONLY in `wrangler secret` / dashboard — never here.
#
# Bootstrap admin password used by scripts/seed.mjs. After first login +
# rotation, UNSET/rotate this value: while set, every admin request pays one
# extra password check (rotation enforcement), and the value itself is a live
# credential as long as any admin still uses it.
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-seeding

# Cloudflare Turnstile secret for public-mutation bot defense.
# Absent locally = documented dev bypass; required in production.
# TURNSTILE_SECRET=

# SendGrid transactional email (verification, password reset, order
# notifications). Absent locally = mail paths log-and-skip; set all three
# for real delivery. Production values live ONLY in `wrangler secret` —
# never here, never hardcoded.
# SENDGRID_API_KEY=
# MAIL_FROM=noreply@example.com
# APP_URL=http://localhost:8787

# Worker environment label consumed by Env.ENVIRONMENT (development default).
# ENVIRONMENT=development
