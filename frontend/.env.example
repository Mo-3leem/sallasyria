# Copy to .env.local for local development (NEVER commit the real file).
# All NEXT_PUBLIC_* values are browser-visible by design — put only public,
# non-secret configuration here. Backend secrets (SendGrid, provider keys,
# signing secrets, Turnstile secret, bootstrap passwords) MUST NEVER go here;
# they live ONLY in `wrangler secret` / dashboard and server-side `.dev.vars`.

# Local Worker API base used as the Next.js rewrite proxy destination.
# Defaults to http://localhost:8787 when unset (see next.config.js).
NEXT_PUBLIC_API_URL=http://localhost:8787

# Cloudflare Turnstile site key (public by design). Empty/unset disables the
# widget locally; production sets the real site key via Pages env vars.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# E2E-only Turnstile escape hatch (NOT a secret — but keep it out of
# production builds anyway). The Playwright E2E frontend build sets it:
#   NEXT_PUBLIC_E2E_ALLOW_MISSING_TURNSTILE=1 npm run build --prefix frontend
# Effect: the guest-checkout submit gate proceeds without a captcha token,
# and ONLY when no site key is configured. Server-side verification
# (TURNSTILE_SECRET) is unaffected — production still rejects missing or
# invalid tokens. Never set this in Pages/production env vars.
# NEXT_PUBLIC_E2E_ALLOW_MISSING_TURNSTILE=
