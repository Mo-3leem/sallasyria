# Copy to .dev.vars for local development (NEVER commit the real file).
# Production values live ONLY in `wrangler secret` / dashboard — never here.
#
# Bootstrap admin password used by scripts/seed.mjs. After first login +
# rotation, UNSET/rotate this value: while set, every admin request pays one
# extra password check (rotation enforcement), and the value itself is a live
# credential as long as any admin still uses it.
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-seeding

# Cloudflare Turnstile secret for public-mutation bot defense.
# Absent locally = documented dev bypass; required in production.
# TURNSTILE_SECRET=

# SendGrid transactional email (verification, password reset, order
# notifications). Absent locally = mail paths log-and-skip; set all three
# for real delivery. Production values live ONLY in `wrangler secret` —
# never here, never hardcoded.
# SENDGRID_API_KEY=
# MAIL_FROM=noreply@example.com
# APP_URL=http://localhost:8787

# Worker environment label consumed by Env.ENVIRONMENT (development default).
# ENVIRONMENT=development

# Public origin of the Next.js frontend for cookie-credentialed CORS.
# Local default (http://localhost:3000) is allowed automatically in
# non-production environments; set this only to override it. In production,
# set the real frontend origin via `wrangler secret` / dashboard — unset
# means the API sends no CORS headers (browser calls blocked, as before).
# FRONTEND_URL=http://localhost:3000

# Self-serve billing (Phase 8). PAYMENT_PROVIDER selects the adapter:
# "stub" (default) runs the local dev adapter with no money and no vendor.
# "real" arms the generic gateway skeleton in src/lib/billing/real.ts.
# TRIAL_DAYS grants that many free trialing days on store creation
# ("0" disables trials); TRIAL_PLAN_CODE names the referenced plan.
# PAYMENT_PROVIDER=stub
# TRIAL_DAYS=14
# TRIAL_PLAN_CODE=basic
# Real-gateway credentials below. Secrets live ONLY in `wrangler secret` /
# dashboard in production — never here, never committed, never logged.
# The "real" adapter fails closed with 503 until ALL THREE are set.
# PROVIDER_API_KEY=
# PROVIDER_WEBHOOK_SECRET=
# PROVIDER_BASE_URL=
